{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rusty-ledger",
  "version": "0.0.1",
  "identifier": "com.ihorkaminnyi.rusty-ledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rusty-ledger",
        "width": 1366,
        "height": 768,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
